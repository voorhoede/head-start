---
import type { SiteLocale, Tag } from '~/lib/datocms/schema';
import { defaultLocale } from '~/lib/i18n';
import { datocmsNoIndex } from '~/lib/search';
import type { Breadcrumb, PageUrl } from '~/lib/routing';
import Breadcrumbs from '~/components/Breadcrumbs/Breadcrumbs.astro';
import IconSprite from '~/components/Icon/IconSprite.astro';
import PreviewModeProvider from '~/components/PreviewMode/PreviewModeProvider.astro';
import PreviewModeSubscription from '~/components/PreviewMode/PreviewModeSubscription.astro';
import { ContentLink } from '@datocms/astro/ContentLink';
import StructuredData from '~/components/StructuredData/StructuredData.astro';
import SkipLink from '~/components/SkipLink/SkipLink.astro';
import OpenInLlm from '~/components/OpenInLlm/OpenInLlm.astro';
import AppHeader from './AppHeader/AppHeader.astro';
import PerfHead from './PerfHead/PerfHead.astro';
import SeoHead from './SeoHead/SeoHead.astro';
import { getAppEntry } from '~/lib/app';
import '~/assets/a11y.css';

interface Props {
  breadcrumbs?: Breadcrumb[];
  pageUrls: PageUrl[];
  seoMetaTags: Tag[];
}

const { locale = defaultLocale } = Astro.params as { locale?: SiteLocale };
const { data: app, subscription } = await getAppEntry(locale);
const { breadcrumbs = [], pageUrls, seoMetaTags } = Astro.props;
const mainContentId = 'content';
const menuItems = app.menuItems ?? [];

const { isPreview, editModeOn } = Astro.locals;
const allowAiBots = !app.noIndex && !isPreview && Boolean(app.allowAiBots);
const prompt = app.openPageInLlmPrompt ?? '';
const llmOptions = app.openPageInLlmOption ?? [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <PerfHead />
    <SeoHead
      pageUrls={pageUrls}
      tags={[...app.site.faviconMetaTags, ...seoMetaTags]}
      allowAiBots={allowAiBots}
    />
    <StructuredData />
  </head>
  <body>
    {Astro.locals.isPreview && (
      <ContentLink enableClickToEdit={editModeOn ? { hoverOnly: true } : undefined} />
    )}
    <PreviewModeProvider>
      {/* Reload the preview when the layout's content (like the App menu) changes, not only the page */}
      <PreviewModeSubscription {...subscription} />
      <SkipLink targetId={mainContentId} />
      <div {...datocmsNoIndex}>
        <AppHeader {menuItems} {pageUrls} />
      </div>
      {
        (breadcrumbs.length > 0 || allowAiBots) && (
          <div class="page-context">
            {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
            {allowAiBots && (
              <div {...datocmsNoIndex} data-nosnippet>
                <Fragment set:html={'<!--googleoff: index-->'} />
                <OpenInLlm {llmOptions} {prompt} />
                <Fragment set:html={'<!--googleon: index-->'} />
              </div>
            )}
          </div>
        )
      }
      {
        /* main element requires tabindex to be focusable, see SkipLink/README.md */
      }
      <main id={mainContentId} tabindex="-1">
        <slot />
      </main>
      <footer {...datocmsNoIndex}>
        <p>Footer</p>
      </footer>
    </PreviewModeProvider>
    <IconSprite />
  </body>
</html>

<style is:global>
  /* very basic reset */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: var(--font-archivo);
  }
  figure {
    margin: 0;
  }
  pre {
    overflow-x: scroll;
  }
</style>
<style>
  /* Sticky footer. @see https://css-tricks.com/a-clever-sticky-footer-technique/ */
  html,
  body {
    height: 100%;
  }
  footer {
    position: sticky;
    top: 100vh;
  }

  /* Basic layout: header, main, footer */
  main {
    margin: auto;
    padding: 1rem;
    width: 800px;
    max-width: calc(100% - 2rem);
    font-size: 20px;
    line-height: 1.6;
  }
  .page-context {
    display: flex;
    align-items: center;
  }
  /* Push the LLM controls to the end, with or without breadcrumbs.
     Targeted by attribute to avoid a class on the spread element,
     which would emit a duplicate `class` (scoped-style hash). */
  .page-context > [data-nosnippet] {
    margin-inline-start: auto;
    padding: 1rem; /* same as the breadcrumbs */
  }
  footer {
    padding: 1rem;
    border-top: 2px solid black;
  }
</style>
