---
import { datocmsAssetsOrigin, datocmsGraphqlOrigin } from '~/lib/datocms';
import { Font } from 'astro:assets';

const preConnectOrigins = [datocmsAssetsOrigin, datocmsGraphqlOrigin];
const { isPreview } = Astro.locals;
---

{preConnectOrigins.map((origin) => <link rel="preconnect" href={origin} />)}

{
  isPreview ? (
    // Preview mode must always show live content. The service worker answers a page
    // navigation from its cache when the server takes more than a few seconds (which it
    // does right after a save, when DatoCMS has just invalidated its cache), so the reload
    // triggered by a content change would show the page as it was before the change.
    // Remove a service worker left by an earlier visit and its caches.
    <script is:inline data-service-worker="unregister">
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker
          .getRegistrations()
          .then((registrations) =>
            Promise.all(registrations.map((registration) => registration.unregister())),
          )
          .then(() => ('caches' in window ? caches.keys() : []))
          .then((keys) => Promise.all(keys.map((key) => caches.delete(key))))
          .catch((err) => {
            console.log('Error while removing service worker');
            console.log(err);
          });
      }
    </script>
  ) : (
    <script is:inline data-service-worker="register">
      window.addEventListener('load', () => {
        if ('serviceWorker' in navigator) {
          navigator.serviceWorker
            .register('/service-worker.js')
            .then((registration) => registration.update())
            .catch((err) => {
              console.log('Error while registering service worker');
              console.log(err);
            });
        }
      });
    </script>
  )
}

<Font cssVariable="--font-archivo" preload />
