---
import AccordionBlock from '~/blocks/AccordionBlock/AccordionBlock.astro';
import type { AccordionBlockFragment, FaqBlockFragment } from '~/lib/datocms/types';

export interface Props {
  block: FaqBlockFragment
}
const { block } = Astro.props;

const items = block.questionAndAnswers
  .map((faq) => faq.questionAndAnswer)
  .filter((item) => item !== undefined && item !== null) as AccordionBlockFragment['items'];
---
{ block.groupTitle && <h2>{ block.groupTitle }</h2> }

<AccordionBlock block={{
  id: block.id,
  isFirstItemOpenOnStart: false,
  items,
}} />
