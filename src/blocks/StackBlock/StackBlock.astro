---
import Blocks from '~/blocks/Blocks.astro';
import type { StackBlockFragment } from '~/lib/datocms/types';

export interface Props {
  block: StackBlockFragment;
}

const { block } = Astro.props;
const items = block.items as StackBlockFragment['items'];
---

{ items.map((item) => (
  block.isTitled && item.title
    ? (
      <section>
        <h2>{ item.title }</h2>
        <Blocks blocks={ item.blocks } />
      </section>
    )
    : (
      <Blocks blocks={ item.blocks } />
    )
))}
