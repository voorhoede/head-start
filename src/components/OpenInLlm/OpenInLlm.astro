---
import type { ExternalLinkFragment } from '~/lib/datocms/types';
import Icon from '~/components/Icon/Icon.astro';
import { t } from '~/lib/i18n';
import { htmlToMarkdownPath } from '~/lib/routing/markdown';

export type Props = {
  llmOptions: ExternalLinkFragment[];
  prompt: string;
};

const { llmOptions, prompt } = Astro.props;

const popoverId = 'open-in-llm-popover';
const markdownHref = `${Astro.url.origin}${htmlToMarkdownPath(Astro.url.pathname)}`;

let searchText = prompt.replaceAll(/\{\s*pageUrl\s*\}/g, markdownHref);
if (searchText === '') searchText = markdownHref;

const llmLinks = llmOptions.map((option) => {
  const href = new URL(option.url);
  href.searchParams.set('q', searchText);
  return { ...option, href: href.toString() };
});
---

<open-in-llm>
  <div data-button-group>
    <button
      type="button"
      data-copy-button
      data-label-copied={t('copy_page_copied')}
      data-label-error={t('copy_page_error')}
      aria-live="polite"
    >
      <Icon name="copy" />
      <span data-copy-label>{t('copy_page')}</span>
    </button>
    <button
      type="button"
      popovertarget={popoverId}
      aria-label={t('open_in_llm')}
      aria-haspopup="true"
      aria-expanded="false"
    >
      <Icon name="chevron-down" />
    </button>
  </div>
  <ul popover id={popoverId}>
    <li>
      <a href={markdownHref}>{t('open_as_markdown')}</a>
    </li>
    {
      llmLinks.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.openInNewTab
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            {link.title}
          </a>
        </li>
      ))
    }
  </ul>
</open-in-llm>

<script src="./OpenInLlm.client.ts"></script>

<style>
  open-in-llm {
    display: inline-flex;
  }

  [data-button-group] {
    display: inline-flex;
    align-items: center;
    anchor-name: --open-in-llm-anchor;
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
  }

  [popover] {
    margin: 0;
    margin-inline-end: 8px;
    width: max-content;
    position: fixed;
    position-anchor: --open-in-llm-anchor;
    position-area: bottom span-left;
    position-try: flip-block, flip-inline;
  }
</style>
