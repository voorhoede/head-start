---
import Blocks from '~/blocks/Blocks.astro';
import PreviewModeSubscription from '~/components/PreviewMode/PreviewModeSubscription.astro';
import Layout from '~/layouts/Default.astro';
import type { SiteLocale } from '~/lib/datocms/schema';
import { getEntry } from '~/lib/content';
import { defaultLocale, isLocale, t } from '~/lib/i18n';
import { noIndexTag, titleTag } from '~/lib/seo';

export const prerender = false;

Astro.response.status = 404;

const localeFromPath = Astro.params.locale as SiteLocale;
const localeFromQuery = Astro.url.searchParams.get('locale') as SiteLocale;
const locale = isLocale(localeFromQuery)
  ? localeFromQuery
  : isLocale(localeFromPath)
    ? localeFromPath
    : defaultLocale;
// Rendered on demand, but reads from the content collection, so it doesn't depend on DatoCMS at runtime.
const entry = await getEntry('NotFoundPage', 'default', locale);
const page = entry?.data;
const title = page?.title ?? t('not_found');
---

<Layout pageUrls={[]} seoMetaTags={[noIndexTag, titleTag(title)]}>
  {entry && <PreviewModeSubscription {...entry.subscription} />}
  <h1>{title}</h1>
  {page && <Blocks blocks={page.bodyBlocks} />}
</Layout>
