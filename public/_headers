# Headers configuration file for Cloudflare Workers static assets
# @see docs: https://developers.cloudflare.com/workers/static-assets/headers/

# Headers for basic security, see docs/security.md
# ⚠️ These headers are only applied to static files (prerendered pages and assets), so keep
#    these rules in sync with their runtime counterparts in src/middleware/security-headers.ts
/*
  Referrer-Policy: no-referrer-when-downgrade
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'self' https://*.admin.datocms.com https://plugins-cdn.datocms.com
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  X-XSS-Protection: 1; mode=block
  Link: </llms.txt>; rel="describedby"; type="text/plain"

# Allow DatoCMS to embed the editor-guide page in an iframe.
# ℹ️ This route is rendered on demand, so in practice the middleware sends these headers;
#    this rule only documents the intended values and applies if the route is ever prerendered.
/cms/editor-guide/
  Content-Security-Policy: frame-ancestors 'self' https://*.datocms.com
  X-Robots-Tag: noindex

# Static assets are hashed and can therefore be cached forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
